# Copie este arquivo para k8s/secret.yaml e preencha com valores reais.
# k8s/secret.yaml NUNCA deve ser commitado (está no .gitignore).
# JWT_SECRET deve ser o MESMO do monólito e da Lambda.
apiVersion: v1
kind: Secret
metadata:
  name: fiap-mecanica-gestao-secret
  namespace: fiap-mecanica
type: Opaque
stringData:
  DB_USERNAME: "CHANGE_ME"
  DB_PASSWORD: "CHANGE_ME"
  JWT_SECRET: "CHANGE_ME"
  NEW_RELIC_LICENSE_KEY: "CHANGE_ME"
